# ============================================================
# Instance B — LMCache MP + proxy + decoders 1–2
# On B: cp .env.b.example .env
# Fill HF_TOKEN and the two host IPs. Never commit a filled .env / .env.b
#
# Decoder 0 stays on A (port 8200). Decoders 1–2 on B (8201, 8202).
# MAX_NUM_SEQS=64 on this two-node run.
# ============================================================

HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

MODEL_NAME=nvidia/DeepSeek-V3.2-NVFP4
MODEL_PATH=/workspace/models/deepseek-v3.2-lmcmp-1p3d

PREFILLER_PORT=8100
DECODER_PORT_D0=8201
DECODER_PORT_D1=8202
NUM_DECODERS=3
PROXY_PORT=9000
TELEMETRY_PORT=5768
LMCACHE_MP_PORT=6000

LMCACHE_MP_BIND_HOST=0.0.0.0
LMCACHE_L1_GB=200
LMCACHE_MP_MAX_WORKERS=12
LMCACHE_SAVE_UNFULL_CHUNK=true
DISAGG_PROXY_KV_STORE_WAIT_TIMEOUT_SEC=120

LMCACHE_MP_CLIENT_HOST=tcp://127.0.0.1

DISAGG_PROXY_PREFILLER_HOST=<NODE_A_IP>
DISAGG_PROXY_DECODER_HOST_CSV=<NODE_A_IP>,<NODE_B_IP>,<NODE_B_IP>
DISAGG_PROXY_DECODER_PORT_CSV=8200,8201,8202

NODE_P_PRIVATE_IP=<NODE_A_IP>
NODE_D_PRIVATE_IP=<NODE_B_IP>

DISAGG_HEALTH_PREFILLER_HOST=<NODE_A_IP>
DISAGG_HEALTH_DECODER_TARGET_CSV=<NODE_A_IP>:8200,<NODE_B_IP>:8201,<NODE_B_IP>:8202
DISAGG_HEALTH_PROXY_HOST=127.0.0.1

PREFILLER_GPUS=0,1,2,3
DECODER_GPUS=4,5,6,7
DECODER_GPUS_D0=0,1,2,3
DECODER_GPUS_D1=4,5,6,7

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

MAX_MODEL_LEN=20000
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=64
BLOCK_SIZE=64
MAX_NUM_BATCHED_TOKENS=32768
DTYPE=auto

VLLM_USE_FLASHINFER_MOE_FP4=1
NCCL_NVLS_ENABLE=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_DEEP_GEMM=1
PYTHONHASHSEED=0
