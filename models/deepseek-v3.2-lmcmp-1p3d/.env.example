# ============================================================
# DeepSeek-V3.2-NVFP4 — LMCache MP 1P3D (single-node / template)
# Copy to .env and set HF_TOKEN. Never commit .env.
#
# Two-node Vast run: on A use .env.a.example, on B use .env.b.example.
# Those files used MAX_NUM_SEQS=64. This template keeps 128 for one box.
# ============================================================

# Hugging Face token. We used a personal hf_ token locally; do not commit it.
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

MODEL_NAME=nvidia/DeepSeek-V3.2-NVFP4
MODEL_PATH=/workspace/models/deepseek-v3.2-lmcmp-1p3d

PREFILLER_PORT=8100
DECODER_PORT=8200
NUM_DECODERS=3
PROXY_PORT=9000
TELEMETRY_PORT=5768
LMCACHE_MP_PORT=6000
LMCACHE_MP_BIND_HOST=0.0.0.0
LMCACHE_L1_GB=200
LMCACHE_MP_MAX_WORKERS=12
LMCACHE_SAVE_UNFULL_CHUNK=true
DISAGG_PROXY_KV_STORE_WAIT_TIMEOUT_SEC=120

# Same-node default. Two-node: point this at the MP host (see .env.a.example).
LMCACHE_MP_CLIENT_HOST=tcp://127.0.0.1

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

PREFILLER_GPUS=0,1,2,3
DECODER_GPUS=4,5,6,7

MAX_MODEL_LEN=20000
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=128
BLOCK_SIZE=64
MAX_NUM_BATCHED_TOKENS=32768
DTYPE=auto

VLLM_USE_FLASHINFER_MOE_FP4=1
NCCL_NVLS_ENABLE=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_DEEP_GEMM=1
PYTHONHASHSEED=0
