# ============================================================
# DeepSeek-V2-Lite — NIXL 1P1D
# Copy to .env and set HF_TOKEN. Never commit .env.
#
# This experiment: RunPod, 2x A100 SXM 80GB, one node.
# Prefill GPU 0, decode GPU 1. NVLink NIXL handoff.
# ============================================================

# Hugging Face token. We used a personal hf_ token locally; do not commit it.
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# Weights on the pod (downloaded once to this path).
MODEL_NAME=/workspace/models/deepseek-v2-lite
MODEL_PATH=/workspace/models/deepseek-v2-lite

PREFILLER_PORT=8100
DECODER_PORT=8200
PROXY_PORT=9000
PREFILLER_NIXL_PORT=5559
DECODER_NIXL_PORT=5560
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

PREFILLER_GPU=0
DECODER_GPU=1

# 32768 covers P95 input (~15840) + P95 output (~561) + buffer.
# GPU_MEM_UTIL 0.85 left ~8GB for NIXL buffers on 80GB A100s.
MAX_MODEL_LEN=32768
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=128
BLOCK_SIZE=32
DTYPE=bfloat16

# Same-node NVLink.
UCX_TLS=cuda_ipc,cuda_copy,tcp

VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_DEEP_GEMM=1
PYTHONHASHSEED=0

# Optional API bearer. We left this unset on private rentals.
# VLLM_API_KEY=
