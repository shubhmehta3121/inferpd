# ============================================================
# DeepSeek V3.2 BF16 — dual-node P/D (phase 2, theory)
# Copy to .env and set the two node IPs. Never commit a filled .env.
#
# This experiment: two 8x H200 nodes (~$30/hr each). Scripts: v2/env.sh
# We never put real IPs in git; fill from `hostname -I` on each machine.
# ============================================================

PREFILLER_IP=<NODE_A_IP>
DECODER_IP=<NODE_B_IP>

# Clients hit the proxy on the decoder node.
PROXY_PORT=9100

# NIXL side channel. With TP=8, vLLM uses 5600-5607 (base + gpu_rank).
NIXL_SIDE_CHANNEL_PORT=5600

UCX_TLS=cuda_ipc,cuda_copy,tcp
UCX_NET_DEVICES=all
