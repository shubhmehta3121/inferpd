# ============================================================
# DeepSeek V3.2 BF16 — single-node bring-up (phase 1)
# Copy to .env and set HF_TOKEN. Never commit .env.
#
# This experiment: 8x H200, TP=8, no P/D split (not enough GPUs left).
# Scripts source 00-env.sh; that file holds most knobs. This .env is secrets.
# ============================================================

# Hugging Face token. We used a personal hf_ token locally; do not commit it.
# Required to download deepseek-ai/DeepSeek-V3.2 (not the -Exp card).
HF_TOKEN=

# Optional API bearer. We set one on this box; leave blank to run open.
# VLLM_API_KEY=

# Values we actually ran (also hardcoded in 00-env.sh):
#   MODEL_REPO=deepseek-ai/DeepSeek-V3.2
#   TENSOR_PARALLEL_SIZE=8
#   GPU_MEMORY_UTILIZATION=0.8   (dropped from 0.85 after OOM)
#   MAX_MODEL_LEN=16384
#   VLLM_SERVE_PORT=8000
#   VLLM_USE_DEEP_GEMM=0         (MoE DeepGEMM off for H200 stability)
#   NCCL_IB_DISABLE=1
