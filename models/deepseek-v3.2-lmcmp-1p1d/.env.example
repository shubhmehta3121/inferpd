# ============================================================
# DeepSeek-V3.2-NVFP4 — LMCache MP 1P1D
# Copy to .env and set HF_TOKEN. Never commit .env.
#
# This experiment: 8x B200, 4 GPUs prefiller + 4 GPUs decoder (TP+EP each).
# Quantized Hub weights. KV wait timeout was 60s here (120s on 1P3D).
# ============================================================

# Hugging Face token. We used a personal hf_ token locally; do not commit it.
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# MODEL_PATH must match 01_download_model.sh MODEL_DIR.
MODEL_NAME=nvidia/DeepSeek-V3.2-NVFP4
MODEL_PATH=/workspace/models/deepseek-v3.2-lmcmp-1p1d

PREFILLER_PORT=8100
DECODER_PORT=8200
NUM_DECODERS=1
PROXY_PORT=9000
TELEMETRY_PORT=5768
LMCACHE_MP_PORT=6000
# Larger host L1 than V2-Lite (80GB). 8 workers on this 8-GPU node.
LMCACHE_L1_GB=200
LMCACHE_MP_MAX_WORKERS=8
LMCACHE_SAVE_UNFULL_CHUNK=true
DISAGG_PROXY_KV_STORE_WAIT_TIMEOUT_SEC=60

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

PREFILLER_GPUS=0,1,2,3
DECODER_GPUS=4,5,6,7

MAX_MODEL_LEN=20000
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=128
BLOCK_SIZE=64
MAX_NUM_BATCHED_TOKENS=32768
DTYPE=auto

VLLM_USE_FLASHINFER_MOE_FP4=1
NCCL_NVLS_ENABLE=0

VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_DEEP_GEMM=1
PYTHONHASHSEED=0

# Optional API bearer. We left this unset on private rentals.
# VLLM_API_KEY=
