# ============================================================
# DeepSeek-V2-Lite — NIXL 2P2D
# Copy to .env and set HF_TOKEN. Never commit .env.
#
# This experiment: RunPod, 4x A100 SXM 80GB, one node.
# Two prefillers on GPUs 0 and 2, two decoders on GPUs 1 and 3.
# ============================================================

# Hugging Face token. We used a personal hf_ token locally; do not commit it.
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

MODEL_NAME=/workspace/models/deepseek-v2-lite
MODEL_PATH=/workspace/models/deepseek-v2-lite

PROXY_PORT=9000

# P0: GPU 0, HTTP 8100, NIXL 5559
# P1: GPU 2, HTTP 8101, NIXL 5561
PREFILLER_GPUS=(0 2)
PREFILLER_PORTS=(8100 8101)
NIXL_PORTS_PREFILLER=(5559 5561)

# D0: GPU 1, HTTP 8200, NIXL 5560
# D1: GPU 3, HTTP 8201, NIXL 5562
DECODER_GPUS=(1 3)
DECODER_PORTS=(8200 8201)
NIXL_PORTS_DECODER=(5560 5562)

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

MAX_MODEL_LEN=32768
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=128
BLOCK_SIZE=32
DTYPE=bfloat16
MAX_NUM_BATCHED_TOKENS=32768

UCX_TLS=cuda_ipc,cuda_copy,tcp

VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_DEEP_GEMM=1
PYTHONHASHSEED=0
