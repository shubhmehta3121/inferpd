# ============================================================
# DeepSeek-V2-Lite — LMCache MP 1P1D
# Copy to .env and set HF_TOKEN. Never commit .env.
#
# This experiment: RunPod, 2x A100 SXM 80GB, one node.
# Shared ZMQ store (port 6000), not NIXL. Prefill GPU 0, decode GPU 1.
# ============================================================

# Hugging Face token. We used a personal hf_ token locally; do not commit it.
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

MODEL_NAME=/workspace/models/deepseek-v2-lite
MODEL_PATH=/workspace/models/deepseek-v2-lite

PREFILLER_PORT=8100
DECODER_PORT=8200
PROXY_PORT=9000
TELEMETRY_PORT=5768
LMCACHE_MP_PORT=6000
# Host RAM for the shared L1. We used 80GB on this 2x A100 box.
LMCACHE_L1_GB=80
LMCACHE_MP_MAX_WORKERS=4
LMCACHE_SAVE_UNFULL_CHUNK=true
DISAGG_PROXY_KV_STORE_WAIT_TIMEOUT_SEC=120

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

PREFILLER_GPU=0
DECODER_GPU=1

# Shorter context than the NIXL trees (those used 32768). Block size 64 here.
MAX_MODEL_LEN=20000
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=128
BLOCK_SIZE=64
MAX_NUM_BATCHED_TOKENS=32768
DTYPE=bfloat16

VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_DEEP_GEMM=1
PYTHONHASHSEED=0

# Optional API bearer. We left this unset on private rentals.
# VLLM_API_KEY=
